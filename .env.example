NODE_ENV=production

# Redis/BullMQ
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=tvmix-video-transcoding

# File locali. I sourcePath dei job devono trovarsi sotto INPUT_ROOT.
INPUT_ROOT=/srv/tvmix/uploads
OUTPUT_ROOT=/srv/tvmix/hls

# URL pubblico corrispondente a OUTPUT_ROOT
HLS_PUBLIC_BASE_URL=https://media.tvmix.it/hls

# Endpoint del backend
WEBHOOK_URL=https://api.tvmix.it/internal/webhooks/video-ready
WEBHOOK_SECRET=change-me
WEBHOOK_TIMEOUT_MS=15000

# Binari installati dal sistema
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# CAX21: tre encoder in parallelo, un thread x264 per rendition.
FFMPEG_VIDEO_THREADS=1
FFMPEG_PRESET=veryfast
HLS_SEGMENT_SECONDS=6

# Retry webhook
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_MS=1000

# Se true, elimina il file sorgente solo dopo transcodifica + webhook riusciti.
DELETE_SOURCE_AFTER_SUCCESS=false
